rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jengtat21997@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        let hasRequired = data.keys().hasAll(['email', 'role', 'createdAt']);
        let validTypes = data.email is string
            && data.role is string
            && data.createdAt is string
            && (data.role == 'user' || (data.role == 'admin' && request.auth.token.email == 'jengtat21997@gmail.com'));
        let validOptional = !data.keys().hasAny(['displayName']) || data.displayName is string;

        return hasRequired && validTypes && validOptional;
      }

      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']);

      allow delete: if isAdmin();
    }

    // Inventory Collection
    match /inventory/{itemId} {
      function isValidItem(data) {
        let hasRequired = data.keys().hasAll(['barcode', 'name', 'category', 'quantity', 'minQuantity', 'lastUpdated']);
        let typesValid = data.barcode is string
            && data.name is string
            && data.category is string
            && data.quantity is number
            && data.minQuantity is number
            && data.lastUpdated is string;
        
        let validOptional = (!data.keys().hasAny(['expiryMonth']) || data.expiryMonth is string)
            && (!data.keys().hasAny(['checkInterval']) || data.checkInterval is number)
            && (!data.keys().hasAny(['imageUrl']) || data.imageUrl is string)
            && (!data.keys().hasAny(['iconName']) || data.iconName is string);
        return hasRequired && typesValid && validOptional;
      }

      // Allow read and update for everyone (guests can scan and withdraw)
      allow read: if true;
      allow update: if isValidItem(incoming());
      
      // Only admins can create and delete
      allow create: if isAdmin() && isValidItem(incoming());
      allow delete: if isAdmin();
    }
  }
}
